# --- core ---------------------------------------------------------------
PORT=8080
BASE_URL=https://radar.example.com
DATABASE_PATH=./data/sunsetradar.db
LOG_LEVEL=info
# HTTP_OFFLINE=true          # fail every outbound fetch fast (tests, sandboxes)

# Self-hosted single-user mode: skips signup and treats every visitor as the
# owner. Put it behind your own auth proxy if you turn this on.
SINGLE_TENANT=false
OWNER_EMAIL=you@example.com
SIGNUPS_OPEN=true

# --- scheduler ----------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=60
POLL_CONCURRENCY=4
RESCAN_HOURS=24
DIGEST_HOUR_UTC=13

# --- optional LLM enrichment -------------------------------------------
# Everything works without this. With a key, summaries and severity calls
# get sharper on the highest-scoring items only.
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-5
# LLM_MIN_RISK_SCORE=25
# LLM_MAX_ITEMS_PER_RUN=40

# --- email --------------------------------------------------------------
# EMAIL_PROVIDER=resend        # resend | postmark | smtp
# EMAIL_FROM=Sunset Radar <alerts@example.com>
# EMAIL_API_KEY=re_...
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# --- billing (only needed for the hosted version) -----------------------
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_TEAM=price_...
